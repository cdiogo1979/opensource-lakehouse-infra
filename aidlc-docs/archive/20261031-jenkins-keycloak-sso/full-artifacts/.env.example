# Optional loopback host ports for the local core runtime.
KEYCLOAK_HOST_PORT=8080
POLARIS_HOST_PORT=8181
RUSTFS_S3_HOST_PORT=9000
RUSTFS_CONSOLE_HOST_PORT=9001
JUPYTERHUB_HOST_PORT=8000
JENKINS_HOST_PORT=8090
JUPYTER_USER_SUBNET=172.30.240.0/24
JUPYTERHUB_BROKER_BIND_IP=172.30.240.2
JUPYTERHUB_BROKER_PORT=8443
# Set by scripts/lakehouse.sh to the absolute host path for DockerSpawner mounts.
JUPYTERHUB_BROKER_CA_HOST_PATH=
JUPYTERHUB_SINGLEUSER_CPU_LIMIT=1
JUPYTERHUB_SINGLEUSER_MEMORY_LIMIT=2G
STARTUP_TIMEOUT_SECONDS=600
