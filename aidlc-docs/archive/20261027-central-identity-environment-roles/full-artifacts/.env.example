# Non-secret local Compose settings. Copy to .env or run scripts/bootstrap-local.sh.
AWS_REGION=us-east-1

S3_API_PORT=9000
S3_CONSOLE_PORT=9001
SPARK_UI_PORT=8082
SPARK_MASTER_PORT=7077

KERBEROS_REALM=LAKEHOUSE.LOCAL
FREEIPA_HOSTNAME=ipa.lakehouse.local
HIVE_SERVICE_FQDN=hive-metastore.lakehouse.local
FREEIPA_VALIDATION_SUBNET=172.30.250.0/24
FREEIPA_VALIDATION_IP=172.30.250.10
# Used for FreeIPA integrated DNS bootstrap; Docker's embedded resolver does not answer the root SOA check.
FREEIPA_DNS_FORWARDER=1.1.1.1
TPCH_SCALE_FACTOR=1
